{
    "swagger": "2.0",
    "info": {
        "description": "Product service API for managing products",
        "title": "Primo Product API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:3333",
    "basePath": "/",
    "paths": {
        "/product": {
            "get": {
                "description": "Retrieve a list of all products",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Get all products",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.ProductListResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            },
            "post": {
                "description": "Create a new product",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Create a product",
                "parameters": [
                    {
                        "description": "Create product request",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/application.CreateProductDto"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.CreateProductResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/product/health": {
            "get": {
                "description": "Check if the Product API is healthy",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Health check",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.HealthCheckResponse"
                        }
                    }
                }
            }
        },
        "/product/{id}": {
            "patch": {
                "description": "Partially update a product by ID. Uses seed data ID as example.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "product"
                ],
                "summary": "Patch a product",
                "parameters": [
                    {
                        "type": "string",
                        "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567801",
                        "description": "Product ID (UUID)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Patch product request",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/application.PatchProductDto"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/response.PatchResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/response.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "application.CreateProductDto": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Apple AirPods Pro 2nd Generation"
                },
                "name": {
                    "type": "string",
                    "example": "AirPods Pro 2"
                },
                "price": {
                    "type": "number",
                    "example": 8990
                },
                "sale_price": {
                    "type": "number",
                    "example": 7990
                }
            }
        },
        "application.PatchProductDto": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Apple iPhone 16 Pro Max 512GB"
                },
                "name": {
                    "type": "string",
                    "example": "iPhone 16 Pro Max"
                },
                "price": {
                    "type": "number",
                    "example": 52900
                },
                "sale_price": {
                    "type": "number",
                    "example": 49900
                }
            }
        },
        "application.ProductDto": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string",
                    "example": "Apple iPhone 16 Pro 256GB"
                },
                "id": {
                    "type": "string",
                    "example": "a1b2c3d4-e5f6-7890-abcd-ef1234567801"
                },
                "name": {
                    "type": "string",
                    "example": "iPhone 16 Pro"
                },
                "price": {
                    "type": "number",
                    "example": 48900
                },
                "sale_price": {
                    "type": "number",
                    "example": 45900
                }
            }
        },
        "response.CreateProductResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "object",
                    "additionalProperties": true
                },
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "message": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "response.ErrorResponse": {
            "description": "Standard API error response format",
            "type": "object",
            "properties": {
                "data": {
                    "type": "object"
                },
                "error_code": {
                    "type": "string",
                    "example": "E_VALIDATION_REQUIRED"
                },
                "message": {
                    "type": "string",
                    "example": "name is required"
                },
                "successful": {
                    "type": "boolean",
                    "example": false
                }
            }
        },
        "response.HealthCheckData": {
            "type": "object",
            "properties": {
                "msg": {
                    "type": "string",
                    "example": "Product API is healthy"
                }
            }
        },
        "response.HealthCheckResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "$ref": "#/definitions/response.HealthCheckData"
                },
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "message": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "response.PatchResponse": {
            "description": "PATCH product success response format",
            "type": "object",
            "properties": {
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        },
        "response.ProductListResponse": {
            "type": "object",
            "properties": {
                "data": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/application.ProductDto"
                    }
                },
                "error_code": {
                    "type": "string",
                    "example": ""
                },
                "message": {
                    "type": "string",
                    "example": ""
                },
                "successful": {
                    "type": "boolean",
                    "example": true
                }
            }
        }
    }
}